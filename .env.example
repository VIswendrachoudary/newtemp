# Database Configuration
DATABASE_URL=postgresql://edna_user:edna_password@localhost:5432/edna_platform
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO/S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=edna-files

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
ML_PIPELINE_URL=http://localhost:8000

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=fasta,fastq,fq,fa,fas,sam,bam

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@edna-platform.com

# BLAST Configuration
BLAST_DB_PATH=./ml-pipeline/data/blast
BLAST_EXEC_PATH=/usr/bin/blast
NCBI_API_KEY=your-ncbi-api-key

# Processing Configuration
MAX_CONCURRENT_JOBS=4
DEFAULT_BATCH_SIZE=100
QUALITY_THRESHOLD=20
MIN_SEQUENCE_LENGTH=50
MAX_SEQUENCE_LENGTH=1000

# Development/Production
NODE_ENV=development
LOG_LEVEL=info
ENABLE_CORS=true

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_CSP=true

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=edna