{
  "name": "edna-backend",
  "version": "1.0.0",
  "description": "Backend API for eDNA biodiversity monitoring platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate": "npm run build && node dist/database/migrate.js",
    "migrate:rollback": "npm run build && node dist/database/rollback.js",
    "seed": "npm run build && node dist/database/seed.js",
    "db:reset": "npm run migrate:rollback && npm run migrate && npm run seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-orcid": "^0.0.3",
    "passport-github2": "^0.1.12",
    "joi": "^17.9.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.5",
    "nodemailer": "^6.9.4",
    "bull": "^4.11.3",
    "ioredis": "^5.3.2",
    "socket.io": "^4.7.2",
    "prisma": "^5.2.0",
    "@prisma/client": "^5.2.0",
    "winston": "^3.10.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "pdfkit": "^0.13.0",
    "exceljs": "^4.3.0",
    "archiver": "^5.3.1",
    "axios": "^1.5.0",
    "minio": "^7.1.3",
    "elasticsearch": "^16.7.3",
    "@elastic/elasticsearch": "^8.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/morgan": "^1.9.4",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/passport": "^1.0.12",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-github2": "^1.2.5",
    "@types/multer": "^1.4.7",
    "@types/nodemailer": "^6.4.9",
    "@types/bull": "^4.10.0",
    "@types/node": "^20.5.0",
    "@types/jest": "^29.5.4",
    "@types/supertest": "^2.0.12",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/pdfkit": "^0.12.9",
    "@types/archiver": "^5.3.2",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "prisma": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}